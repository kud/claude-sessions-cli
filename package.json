{
  "name": "@kud/claude-sessions-cli",
  "version": "2.7.0",
  "description": "TUI session manager for Claude Code",
  "homepage": "https://kud.io/projects/claude-sessions-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/claude-sessions-cli.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-sessions": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --test test/smoke.test.mjs"
  },
  "dependencies": {
    "@kud/ink-ui": "0.44.1",
    "ink": "8.0.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
